# ============================================
# AI Development Team — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Anthropic API ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- GitHub ---
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=oleglgt
GITHUB_REPO=Ollgt_Develop_team

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Agent Settings ---
# Model for agents (claude-sonnet-4-5-20250929 recommended for balance of cost/quality)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Polling interval in seconds (how often orchestrator checks for new tasks)
POLL_INTERVAL=30

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
